<?xml version="1.0"?>
<!--
  touch_tool_tcp.urdf
  TCP de palpação do Touch Pack (Gazebo Classic) — pilha que o CR10 carrega no
  flange (Link6), montada a partir de `cad/step/MONTAGEM_COMPLETA.step`:

      acoplador_robo → célula axial de 100 kg (viga S) → acoplador_tool
          → touch_tool → ponteira D + laminado tátil 5×5

  A GEOMETRIA SEGUE A CÉLULA QUE ESTÁ PARAFUSADA, não o driver que está no ar.
  O argumento `force_sensor` do launch escolhe qual RECEIVER sobe; ele não move
  o TCP. Entre 18/08/2026 e 26/08/2026 este arquivo descreveu a pilha da FA7155
  de 6 eixos (TCP a 67,7 mm) — a viga S é 94,5 mm mais longa, e todo ensino de
  pose feito com a ferramenta curta precisa ser refeito. O carimbo
  `tool_tcp_mm` (constants.tool_stamp) existe exatamente para o operador ver
  isso ao carregar home/poses/contato aprendido, em vez de descobrir na descida.

  Os sólidos vêm de UMA montagem, já posicionados entre si, e o gerador
  normaliza pela face que parafusa no punho do CR10 — o punho (`pulso_robo_cr10`
  no STEP) é referência de montagem e não entra nem na massa nem na origem.

  PILHA NO EIXO +Z DO FLANGE (mm, lida do CAD)
  ══════════════════════════════════════════
      0,0 …  18,5   acoplador_robo    (disco ⌀63,5, impresso; parafusa no punho)
     15,5 …  91,7   célula 100 kg     (viga S 50,8 × 19,1 × 76,2, aço-liga;
                                       os 3 mm de baixo entram no acoplador)
     88,7 … 118,7   acoplador_tool    (disco ⌀63,5 × 30, impresso)
    101,7 … 157,7   touch_tool        (corpo ⌀58 × 56 que afina para a haste)
    147,7 … 161,7   ponteira D        (luva sobre a haste + cabeça 22,4 × 24,9)
    161,7 … 162,2   laminado tátil 5×5 (flex + piezorresistiva + flex, 0,5 mm)

    Z = 162,2 mm → tcp_link (face de contato do laminado)

  As sobreposições de faixa (viga dentro do acoplador, haste dentro da luva)
  são os próprios encaixes mecânicos — cada link tem colisão só do que fica
  EXPOSTO, senão o ODE ganha geometria duplicada dentro do mesmo corpo rígido.

  SENSOR TÁTIL 5×5. O laminado é colado na face da ponteira D, que foi
  desenhada para ele: a cabeça tem 22,4 × 24,9 mm e o laminado 17 × 19,47 mm,
  então ele fica INTEIRO apoiado, sem o balanço de borda que a ponteira F
  (15,4 × 17,4 mm) impunha. As três camadas viram um link só: são coladas e não
  têm grau de liberdade nenhum entre si.

  MASSAS E INÉRCIAS
  ═════════════════
  Calculadas da geometria real por `scripts/gen_tcp_meshes_from_step.py` na
  pilha `load_cell` (é o default do script), que também gera os STL de
  `meshes/`. Dois hífens seguidos são ilegais dentro de um comentário XML, daí
  a opção não aparecer escrita aqui. Densidades:
    peças impressas (PLA 0,25 mm, 40% infill) ... 950 kg/m³
    viga S de 100 kg (aço-liga) ................. 7850 kg/m³
        (aqui a geometria sabe mais que o catálogo: o STEP traz os rasgos em S,
        60,5 cm³ contra 74,0 cm³ do envelope, e integrar dá 474,8 g — melhor
        que o "≈0,5 kg" da folha de dados.)
  Total do conjunto: 0,6034 kg, CoM em Z = +58,7 mm do flange (peso 5,92 N).
  A pilha da FA7155 pesava 0,3837 kg com CoM a +19,5 mm: a compensação de
  gravidade em `config/tactile_controllers.yaml` muda junto.

  TCP em (0, 0, +162,2 mm) no frame do Link6, sem rotação — espelhado em
  `touch_pack.kinematics.T_TOUCH_TOOL_ATTACH` e na compensação de gravidade de
  `config/tactile_controllers.yaml`. Mexeu aqui, mexe nos três.

  Uso standalone (Gazebo): mantenha o bloco world/Link6 abaixo.
  Integração no CR10: o launch injeta os mesmos links/juntas usando o Link6
  do robô — este arquivo é a referência legível e o alvo de `check_urdf`.
-->
<robot name="touch_tool_tcp">

  <!-- ══════════════════════════════════════════════════════════════════
       ROOT (modo standalone): liga a ferramenta ao world para teste.
       Na integração com o CR10 este bloco sai e o Link6 é o do robô.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="Link6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Placeholder do flange (substituído pelo Link6 do CR10 na integração). -->
  <link name="Link6">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-9" ixy="0.0" ixz="0.0"
               iyy="1e-9" iyz="0.0" izz="1e-9"/>
    </inertial>
  </link>

  <!-- Azul do filamento: todas as peças impressas saíram na mesma cor. -->
  <material name="printed_blue">
    <color rgba="0.11 0.35 0.78 1.0"/>
  </material>
  <!-- Aço niquelado da viga S. -->
  <material name="steel_grey">
    <color rgba="0.62 0.63 0.65 1.0"/>
  </material>

  <!-- ══════════════════════════════════════════════════════════════════
       ACOPLADOR DO ROBÔ — cad/step/acoplador_robo.step
       Disco impresso ⌀63,5 × 18,5 mm, parafusado direto na face do flange do
       CR10. É a peça que adapta o furo do punho ao rosqueado M12 da viga S,
       e por isso ela existe aqui e não existia na pilha da FA7155 (aquela
       célula traz o próprio flange fixo comprado).
  ══════════════════════════════════════════════════════════════════ -->
  <link name="coupler_robot_link">
    <inertial>
      <origin xyz="0.00000 -0.00000 0.00912" rpy="0 0 0"/>
      <mass value="0.0419"/>
      <inertia ixx="1.334e-05" ixy="-1.780e-21" ixz="-3.581e-21"
               iyy="1.282e-05" iyz="2.036e-20" izz="2.400e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://touch_pack/meshes/acoplador_robo.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed_blue"/>
    </visual>
    <collision name="col_coupler_robot">
      <origin xyz="0 0 0.00925" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03175" length="0.0185"/></geometry>
    </collision>
  </link>

  <joint name="coupler_robot_attach" type="fixed">
    <parent link="Link6"/>
    <child link="coupler_robot_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       CÉLULA AXIAL DE 100 kg — cad/step/celula_carga_100kg.step
       Viga S de aço-liga, 50,8 × 19,1 × 76,2 mm, 2 mV/V. Mede UM eixo: a
       força ao longo de +Z do flange. Não há convenção de sinal a resolver no
       URDF — quem fixa "compressão positiva" é o SLOPE da calibração
       (constants.lc_force_n), medido com massas padrão sobre a célula.
       Colisão só do trecho EXPOSTO (3 … 73,2 mm no frame do link): as pontas
       ficam dentro dos acopladores.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="load_cell_link">
    <inertial>
      <origin xyz="-0.00000 -0.00000 0.03810" rpy="0 0 0"/>
      <mass value="0.4748"/>
      <inertia ixx="2.577e-04" ixy="-1.485e-22" ixz="-1.791e-05"
               iyy="3.446e-04" iyz="-6.480e-23" izz="1.170e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://touch_pack/meshes/celula_carga_100kg.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="steel_grey"/>
    </visual>
    <collision name="col_load_cell">
      <origin xyz="0 0 0.0381" rpy="0 0 0"/>
      <geometry><box size="0.0508 0.0191 0.0702"/></geometry>
    </collision>
  </link>

  <joint name="load_cell_attach" type="fixed">
    <parent link="coupler_robot_link"/>
    <child link="load_cell_link"/>
    <origin xyz="0 0 0.0155" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       ACOPLADOR DA FERRAMENTA — cad/step/acoplador_tool.step
       Disco ⌀63,5 × 30 mm rosqueado na ponta livre da viga S. Do meio para
       cima ele afina e entra no touch_tool, então só os 13 mm de baixo têm
       colisão.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="coupler_tool_link">
    <inertial>
      <origin xyz="0.00000 -0.00000 0.01016" rpy="0 0 0"/>
      <mass value="0.0444"/>
      <inertia ixx="1.351e-05" ixy="1.019e-19" ixz="9.223e-21"
               iyy="1.299e-05" iyz="8.086e-20" izz="2.203e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://touch_pack/meshes/acoplador_tool.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed_blue"/>
    </visual>
    <collision name="col_coupler_tool">
      <origin xyz="0 0 0.0065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03175" length="0.013"/></geometry>
    </collision>
  </link>

  <joint name="coupler_tool_attach" type="fixed">
    <parent link="load_cell_link"/>
    <child link="coupler_tool_link"/>
    <origin xyz="0 0 0.0732" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       TOUCH TOOL — cad/step/touch_tool.step
       Corpo ⌀58 × 56 mm que afina para a haste onde a ponteira encaixa. É o
       que dá à ferramenta o comprimento que a FA7155 não tem: é ele, mais a
       viga S, que responde pelos 94,5 mm a mais de TCP.
       Colisão até 46 mm — daí para cima a luva da ponteira cobre a haste.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="touch_tool_link">
    <inertial>
      <origin xyz="0.00000 -0.00000 0.01569" rpy="0 0 0"/>
      <mass value="0.0366"/>
      <inertia ixx="1.242e-05" ixy="-1.512e-19" ixz="2.469e-19"
               iyy="1.242e-05" iyz="-5.483e-21" izz="1.805e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://touch_pack/meshes/touch_tool.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed_blue"/>
    </visual>
    <collision name="col_touch_tool">
      <origin xyz="0 0 0.023" rpy="0 0 0"/>
      <geometry><cylinder radius="0.029" length="0.046"/></geometry>
    </collision>
  </link>

  <joint name="touch_tool_attach" type="fixed">
    <parent link="coupler_tool_link"/>
    <child link="touch_tool_link"/>
    <origin xyz="0 0 0.013" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       PONTEIRA D + LAMINADO 5×5 — cad/step/ponteira_D_sensor_5x5.step
       Luva que desce sobre a haste do touch_tool (os 10 mm de baixo ficam
       cobertos) + cabeça 22,4 × 24,9 mm, com o laminado tátil colado na face.
       É a peça hot-swap: trocar de ponteira muda a altura do TCP.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="tool_tip_link">
    <inertial>
      <origin xyz="-0.00000 0.00027 0.00704" rpy="0 0 0"/>
      <mass value="0.0057"/>
      <inertia ixx="3.941e-07" ixy="1.706e-09" ixz="-3.057e-22"
               iyy="3.478e-07" iyz="2.214e-09" izz="5.532e-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://touch_pack/meshes/ponteira_D_sensor_5x5.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="printed_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://touch_pack/meshes/sensor_5x5_pad.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="steel_grey"/>
    </visual>
    <!-- Só a cabeça que sobra do touch_tool (de +10 a +14 mm). -->
    <collision name="col_tip_head">
      <origin xyz="0 0 0.012" rpy="0 0 0"/>
      <geometry><box size="0.0224 0.0249 0.004"/></geometry>
    </collision>
    <!-- Laminado: é ESTA caixa que toca a peça. -->
    <collision name="col_tip_pad">
      <origin xyz="0 0 0.01425" rpy="0 0 0"/>
      <geometry><box size="0.0170 0.0195 0.0005"/></geometry>
    </collision>
  </link>

  <joint name="tool_tip_attach" type="fixed">
    <parent link="touch_tool_link"/>
    <child link="tool_tip_link"/>
    <origin xyz="0 0 0.046" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       tcp_link — face de contato do laminado, Z = +162,2 mm do flange.
       Soma da cadeia: 0 + 15,5 + 73,2 + 13,0 + 46,0 + 14,5 = 162,2 mm.
  ══════════════════════════════════════════════════════════════════ -->
  <link name="tcp_link"/>

  <joint name="tcp_alias_joint" type="fixed">
    <parent link="tool_tip_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.0145" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════════════════════════════
       PROPRIEDADES GAZEBO (ODE)
       Em Gazebo Classic a cor declarada no material do link nem sempre
       renderiza; o override ambient/diffuse/specular no bloco gazebo
       reference abaixo é o que efetivamente colore a peça.

       NB: nada de sintaxe de tag dentro de comentário aqui. O launch monta o
       URDF mínimo do robot_state_publisher removendo visual/collision/
       inertial por regex, e um nome de tag solto no meio de um comentário
       faz a regex casar através dele e comer o fechamento do link.
  ══════════════════════════════════════════════════════════════════ -->
  <gazebo reference="Link6">
    <self_collide>0</self_collide>
  </gazebo>

  <gazebo reference="coupler_robot_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.06 0.20 0.45 1</ambient>
      <diffuse>0.11 0.35 0.78 1</diffuse>
      <specular>0.25 0.25 0.30 1</specular>
    </material></visual>
  </gazebo>

  <gazebo reference="load_cell_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.40 0.41 0.43 1</ambient>
      <diffuse>0.62 0.63 0.65 1</diffuse>
      <specular>0.85 0.85 0.90 1</specular>
    </material></visual>
  </gazebo>

  <gazebo reference="coupler_tool_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.06 0.20 0.45 1</ambient>
      <diffuse>0.11 0.35 0.78 1</diffuse>
      <specular>0.25 0.25 0.30 1</specular>
    </material></visual>
  </gazebo>

  <gazebo reference="touch_tool_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.40</mu1><mu2>0.40</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.06 0.20 0.45 1</ambient>
      <diffuse>0.11 0.35 0.78 1</diffuse>
      <specular>0.25 0.25 0.30 1</specular>
    </material></visual>
  </gazebo>

  <!-- Ponteira: atrito mais alto — é a superfície que desliza sobre a peça. -->
  <gazebo reference="tool_tip_link">
    <self_collide>0</self_collide><gravity>true</gravity>
    <mu1>0.60</mu1><mu2>0.60</mu2><kp>1.0e5</kp><kd>100.0</kd>
    <maxContacts>4</maxContacts><minDepth>0.0002</minDepth><maxVel>0.05</maxVel>
    <visual><material>
      <ambient>0.06 0.20 0.45 1</ambient>
      <diffuse>0.11 0.35 0.78 1</diffuse>
      <specular>0.25 0.25 0.30 1</specular>
    </material></visual>
  </gazebo>

  <!-- Feedback de força/torque na junta onde a célula real está montada. -->
  <gazebo reference="load_cell_attach">
    <provideFeedback>true</provideFeedback>
  </gazebo>

</robot>
