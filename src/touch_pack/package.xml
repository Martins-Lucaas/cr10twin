<?xml version="1.0"?>
<package format="3">
  <name>touch_pack</name>
  <version>0.3.0</version>
  <description>
    Plataforma de palpação tátil — CR10 + COVVI Index com FT no dedo.
    Reproduz o protocolo de Gupta et al. 2021 (CONTACT → HOLD → SLIDING →
    RETRACT) com controle de admitância para manter a força normal
    durante o deslizamento. Inclui driver TCP/IP para o controlador
    Dobot CR (192.168.5.1) compatível com bring-up real.
  </description>
  <maintainer email="lucaspmartins14@gmail.com">Lucas Martins</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>touch_pack_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- Deps de runtime que os nós/launch IMPORTAM e que faltavam na
       declaração — sem elas `rosdep install` não resolve nada delas e a
       build/execução quebra em máquina limpa. `covvi_interfaces` entra
       porque vários nós fazem soft-import dos tipos mesmo em modo só-sim.
       `hand_pack` NÃO entra de propósito: hand_pack já depende de
       touch_pack, então declará-lo aqui fecharia um ciclo no colcon. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>covvi_interfaces</exec_depend>

  <!-- Controlador opcional ativável via tactile_controllers.yaml -->
  <exec_depend>admittance_controller</exec_depend>
  <exec_depend>kinematics_interface_kdl</exec_depend>
  <exec_depend>force_torque_sensor_broadcaster</exec_depend>

  <!-- Simulação Gazebo Classic: libgazebo_ros_ft_sensor.so (F/T simulada na
       junta da célula) + libgazebo_ros_state.so (research_lab.world). -->
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <!-- libgazebo_mimic_joint_plugin.so: transmite força pelas juntas mimic
       da mão COVVI (end_effector:=hand) — sem ele a preensão não segura o
       objeto por atrito. Fornecido pelo pacote gazebo_mimic_plugin deste
       mesmo workspace (reescrita ROS-free do roboticsgroup, porque o
       upstream é catkin/ROS 1). Ver src/grasp_ml_pack/doc/covvi_control.md. -->
  <exec_depend>gazebo_mimic_plugin</exec_depend>
  <!-- Viewport 3D da GUI. Sem PIL a aba cai para o desenho em esqueleto;
       sem VTK ela usa o rasterizador em software, que precisa decimar as
       malhas. Com os dois, a aba mostra a malha EXATA do URDF via GPU. -->
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-vtk9</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
