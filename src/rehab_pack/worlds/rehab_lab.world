    <!-- ================= Animação (só visual) =================
      Atores <actor> sem skin: visuais de primitivas movidos por <script> em
      laço; não têm colisão nem física. Todos ficam a mais de 1,6 m de
      (0,30; 0) em XY (inclusive entre waypoints) e longe da cadeira do voluntário.
      Gerados por um script auxiliar (fora do repo) e mantidos à mão; as
      restrições são verificadas em test/test_world.py. -->
    <!-- Cursor do jogo na TV: centro -> alvo -> centro, 8 alvos (25.6 s). -->
    <actor name="jogo_cursor">
