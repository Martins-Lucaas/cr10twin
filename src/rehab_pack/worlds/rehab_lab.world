<?xml version="1.0" ?>
<!--
  rehab_lab.world — laboratório de reabilitação (Gazebo Classic 11).
  Física, piso (z = 0) e mesa 0,60 x 1,10 x 0,05 m em (0,30; 0; 0,725) idênticos
  à versão mínima; o robô fica em x = 0,30. A cadeira do voluntário (vazia) fica em
  (1,20; 0), virada para -x (para o robô e a TV na parede de fundo).
  Decoração: só primitivas SDF + gazebo.material (sem URIs remotas, para o
  Gazebo não tentar baixar nada). Tudo static e SÓ VISUAL; colisão apenas no
  piso, na mesa e nas 2 paredes (fundo x=-1,65 e direita do voluntário y=+2,25; lado -y aberto).
  Vida na cena: atores <actor> só visuais no fim do arquivo (jogo na TV, relógio, nuvens, pássaros).
  Este arquivo foi gerado por um script e depois mantido à mão.
-->
<sdf version="1.6">
  <world name="rehab_lab">

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.80 0.80 0.78 1</diffuse>
      <specular>0.08 0.08 0.08 1</specular>
      <direction>-0.30 0.50 -1.00</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <light name="luz_central" type="point">
      <pose>0.3 0 2.5 0 0 0</pose>
      <diffuse>0.55 0.53 0.48 1</diffuse>
      <specular>0.03 0.03 0.03 1</specular>
      <attenuation><range>8</range><constant>0.8</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="luz_fundo" type="point">
      <pose>-0.8 1.0 2.4 0 0 0</pose>
      <diffuse>0.55 0.53 0.48 1</diffuse>
      <specular>0.03 0.03 0.03 1</specular>
      <attenuation><range>8</range><constant>0.8</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="luz_frente" type="point">
      <pose>1.8 -1.1 2.4 0 0 0</pose>
      <diffuse>0.55 0.53 0.48 1</diffuse>
      <specular>0.03 0.03 0.03 1</specular>
      <attenuation><range>8</range><constant>0.8</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <scene>
      <ambient>0.50 0.50 0.50 1</ambient>
      <background>0.66 0.82 0.96 1</background>
      <shadows>true</shadows>
    </scene>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.81</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>50</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>1.0e-5</cfm><erp>0.25</erp>
          <contact_max_correcting_vel>2.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
          <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
          <material><ambient>0.62 0.60 0.56 1</ambient><diffuse>0.70 0.68 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mesa: topo 0,60 x 1,10 x 0,05 centrado em x = 0,30 (superfície em z = 0,75). -->
    <model name="lab_table">
      <static>true</static>
      <link name="top">
        <pose>0.30 0 0.725 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>0.60 1.10 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 1.10 0.05</size></box></geometry>
          <material>
            <ambient>0.60 0.47 0.31 1</ambient>
            <diffuse>0.74 0.59 0.40 1</diffuse>
            <specular>0.18 0.16 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="leg_a">
        <pose>0.05 -0.50 0.375 0 0 0</pose>
        <visual name="v"><pose>0 0 -0.015 0 0 0</pose><geometry><box><size>0.05 0.05 0.72</size></box></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse><specular>0.45 0.45 0.50 1</specular></material></visual>
      </link>
      <link name="leg_b">
        <pose>0.05 0.50 0.375 0 0 0</pose>
        <visual name="v"><pose>0 0 -0.015 0 0 0</pose><geometry><box><size>0.05 0.05 0.72</size></box></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse><specular>0.45 0.45 0.50 1</specular></material></visual>
      </link>
      <link name="leg_c">
        <pose>0.55 -0.50 0.375 0 0 0</pose>
        <visual name="v"><pose>0 0 -0.015 0 0 0</pose><geometry><box><size>0.05 0.05 0.72</size></box></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse><specular>0.45 0.45 0.50 1</specular></material></visual>
      </link>
      <link name="leg_d">
        <pose>0.55 0.50 0.375 0 0 0</pose>
        <visual name="v"><pose>0 0 -0.015 0 0 0</pose><geometry><box><size>0.05 0.05 0.72</size></box></geometry><material><ambient>0.14 0.15 0.17 1</ambient><diffuse>0.20 0.21 0.24 1</diffuse><specular>0.45 0.45 0.50 1</specular></material></visual>
      </link>
    </model>

