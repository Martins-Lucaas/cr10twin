#include "main.h"
#include <stdio.h>

#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS * COLS)

#define FILTER_SIZE 3
#define I_THRESHOLD 0.1f
#define SPIKE_DEBOUNCE_MS 50

// Parâmetros do modelo Izhikevich
float a = 0.02f;
float b = 0.2f;
float c = -65.0f;
float d = 8.0f;

float v[NUM_SENSORS];
float u[NUM_SENSORS];
float I_in[NUM_SENSORS];
uint32_t spikes[NUM_SENSORS];

// Buffer para filtro média móvel
float I_in_buffer[NUM_SENSORS][FILTER_SIZE] = {0};
int filter_index = 0;

// Controle de debounce de spike
uint32_t last_spike_time[NUM_SENSORS] = {0};

char msg[32];

// Mapeamento das linhas (GPIO saída)
GPIO_TypeDef* row_ports[ROWS] = {GPIOC, GPIOC, GPIOF, GPIOF};
uint16_t row_pins[ROWS]       = {GPIO_PIN_0, GPIO_PIN_3, GPIO_PIN_3, GPIO_PIN_5};

// Mapeamento das colunas (ADC entrada)
uint32_t adc_channels[COLS] = {
    ADC_CHANNEL_9,   // PB1
    ADC_CHANNEL_12,  // PC2
    ADC_CHANNEL_5,   // PF4
    ADC_CHANNEL_0    // PA0
};

ADC_HandleTypeDef hadc1;
UART_HandleTypeDef huart3;

#define ADC_RESOLUTION      4095.0f
#define SENSOR_MAX_VOLTAGE  2.0f    // tensão máxima esperada do sensor
#define VREF                3.3f
#define I_MAX               5.0f    // corrente máxima para o modelo

// Protótipos das funções de inicialização
void SystemClock_Config(void);
void MX_GPIO_Init(void);
void MX_ADC1_Init(void);
void MX_USART3_UART_Init(void);
void Error_Handler(void);

uint32_t Read_ADC_Channel(uint32_t channel) {
    ADC_ChannelConfTypeDef sConfig = {0};
    sConfig.Channel = channel;
    sConfig.Rank = ADC_REGULAR_RANK_1;
    sConfig.SamplingTime = ADC_SAMPLETIME_15CYCLES;
    HAL_ADC_ConfigChannel(&hadc1, &sConfig);

    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, HAL_MAX_DELAY);
    uint32_t val = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);

    return val;
}

float Calibrate_Input(uint32_t adc_val) {
    float adc_max_expected = (SENSOR_MAX_VOLTAGE / VREF) * ADC_RESOLUTION;

    float normalized = ((float)adc_val) / adc_max_expected;

    if (normalized > 1.0f) normalized = 1.0f;
    if (normalized < 0.0f) normalized = 0.0f;

    return normalized * I_MAX;
}

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_ADC1_Init();
    MX_USART3_UART_Init();

    // Inicializa variáveis do modelo
    for (int i = 0; i < NUM_SENSORS; i++) {
        v[i] = -65.0f;
        u[i] = b * v[i];
        spikes[i] = 0;
        I_in[i] = 0.0f;

        for(int f=0; f<FILTER_SIZE; f++) {
            I_in_buffer[i][f] = 0.0f;
        }
        last_spike_time[i] = 0;
    }

    while (1) {
        // Ativa só a linha 0 (nível baixo), as outras em nível alto
        for (int rr = 0; rr < ROWS; rr++) {
            HAL_GPIO_WritePin(row_ports[rr], row_pins[rr], (rr == 0) ? GPIO_PIN_RESET : GPIO_PIN_SET);
        }
        HAL_Delay(2); // aguarda estabilizar linha

        for (int c_idx = 0; c_idx < COLS; c_idx++) {
            int idx = 0 * COLS + c_idx;
            uint32_t adc_val = Read_ADC_Channel(adc_channels[c_idx]);
            float input_raw = Calibrate_Input(adc_val);

            // Threshold para evitar ruído baixo
            if (input_raw < I_THRESHOLD) input_raw = 0.0f;

            // Atualiza buffer para filtro média móvel
            I_in_buffer[idx][filter_index] = input_raw;

            // Calcula média móvel
            float input_filtered = 0.0f;
            for (int i = 0; i < FILTER_SIZE; i++) {
                input_filtered += I_in_buffer[idx][i];
            }
            input_filtered /= FILTER_SIZE;

            I_in[idx] = input_filtered;

            // Atualiza modelo Izhikevich (2 passos)
            for (int step = 0; step < 2; step++) {
                v[idx] += 0.5f * (0.04f * v[idx] * v[idx] + 5 * v[idx] + 140 - u[idx] + I_in[idx]);
                u[idx] += a * (b * v[idx] - u[idx]);
            }

            uint32_t now = HAL_GetTick();
            if ((v[idx] >= 30.0f) && (now - last_spike_time[idx] > SPIKE_DEBOUNCE_MS)) {
                v[idx] = c;
                u[idx] += d;
                spikes[idx]++;
                last_spike_time[idx] = now;

                int len = snprintf(msg, sizeof(msg), "%d\n", idx);
                HAL_UART_Transmit(&huart3, (uint8_t*)msg, len, HAL_MAX_DELAY);
            }
        }

        filter_index = (filter_index + 1) % FILTER_SIZE;

        HAL_Delay(10); // pequeno delay para não travar MCU
    }
}

