/* Private define ------------------------------------------------------------*/
#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS*COLS)

/* Mapeamento de LINHAS (GPIO de saída - seleciona a linha ativa em nível baixo) */
GPIO_TypeDef* row_ports[ROWS] = {GPIOC, GPIOC, GPIOF, GPIOF};
uint16_t      row_pins [ROWS] = {GPIO_PIN_0, GPIO_PIN_3, GPIO_PIN_3, GPIO_PIN_5};
/*            PC0         PC3        PF3         PF5 */

/* Mapeamento de COLUNAS (ADC1 - entradas analógicas) */
static const uint32_t adc_channels[COLS] = {
  ADC_CHANNEL_9,   /* PB1 */
  ADC_CHANNEL_12,  /* PC2 */
  ADC_CHANNEL_1,   /* PA1 */
  ADC_CHANNEL_0    /* PA0 */
};

/* Calibração do sinal -> corrente do modelo */
#define ADC_RESOLUTION       4095.0f
#define SENSOR_MAX_VOLTAGE   2.0f   /* Vmax do sensor esperado */
#define VREF                 3.3f
#define I_MAX                5.0f   /* Corrente máxima no modelo */

/* Modelo Izhikevich (Regular Spiking) */
static float a = 0.02f;
static float b = 0.20f;
static float c_rst = -65.0f;
static float d_inc = 8.0f;

static float v[NUM_SENSORS];
static float u[NUM_SENSORS];
static float I_in[NUM_SENSORS];
static uint32_t spikes[NUM_SENSORS];

/* UART print buffer */
static char txbuf[256];

/* Estado/Buffer ADC+DMA */
static volatile uint8_t active_row = 0;   /* linha ativa atual */
static uint32_t adc_buffer[COLS];         /* 4 amostras por TRGO (uma por coluna) */

/* Handles HAL ----------------------------------------------------------------*/
ADC_HandleTypeDef   hadc1;
DMA_HandleTypeDef   hdma_adc1;
TIM_HandleTypeDef   htim6;
UART_HandleTypeDef  huart3;

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_USART3_UART_Init(void);
static void MX_ADC1_Init(void);
static void MX_TIM6_Init_4kHz_TRGO(void);

/* USER CODE BEGIN PFP */
static inline void select_row(uint8_t row);
static inline float Calibrate_Input(uint32_t adc_val);
static inline void izhikevich_step(int idx, float I);
static inline void pulse_us_GPIOB8(uint32_t us);
/* USER CODE END PFP */

/* USER CODE BEGIN 0 */
static inline float Calibrate_Input(uint32_t adc_val) {
  float adc_max_expected = (SENSOR_MAX_VOLTAGE / VREF) * ADC_RESOLUTION;
  float normalized = ((float)adc_val) / adc_max_expected;
  if (normalized > 1.0f) normalized = 1.0f;
  if (normalized < 0.0f) normalized = 0.0f;
  return normalized * I_MAX;
}

static inline void select_row(uint8_t row) {
  /* Linha ativa em nível baixo; demais alto */
  for (int r = 0; r < ROWS; r++) {
    HAL_GPIO_WritePin(row_ports[r], row_pins[r],
                      (r == row) ? GPIO_PIN_RESET : GPIO_PIN_SET);
  }
}

/* Passo do Izhikevich (2 semipassos de 0.5 ms = 1 ms total) */
static inline void izhikevich_step(int idx, float I) {
  for (int step = 0; step < 2; step++) {
    v[idx] += 0.5f * (0.04f * v[idx] * v[idx] + 5.0f * v[idx] + 140.0f - u[idx] + I);
    u[idx] += a * (b * v[idx] - u[idx]);
  }
}

/* Pulso ~10–15us em PB8 (ajuste fino por ensaio) */
static inline void pulse_us_GPIOB8(uint32_t us) {
  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_SET);
  volatile uint32_t cycles = us * 80; /* ajuste empírico p/ ~HCLK */
  while (cycles--) { __NOP(); }
  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_RESET);
}
/* USER CODE END 0 */

/**
  * @brief  Ponto de entrada
  */
int main(void)
{
  /* Reset periféricos / SysTick */
  HAL_Init();

  /* Clock */
  SystemClock_Config();

  /* GPIO / DMA / UART / ADC / TIM */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART3_UART_Init();
  MX_ADC1_Init();
  MX_TIM6_Init_4kHz_TRGO();

  /* Inicializa o modelo */
  for (int i = 0; i < NUM_SENSORS; i++) {
    v[i] = -65.0f;
    u[i] = b * v[i];
    I_in[i] = 0.0f;
    spikes[i] = 0;
  }

  /* Começa com linha 0 ativa */
  active_row = 0;
  select_row(active_row);

  /* Inicia ADC+DMA (circular). As conversões serão disparadas pelo TRGO do TIM6 */
  if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, COLS) != HAL_OK) {
    Error_Handler();
  }

  /* Inicia TIM6 (gera TRGO a cada update) */
  if (HAL_TIM_Base_Start(&htim6) != HAL_OK) {
    Error_Handler();
  }

  /* Telemetria periódica */
  uint32_t last_tx = HAL_GetTick();

  while (1)
  {
    /* Envia linha "Spikes: ..." a cada ~100 ms */
    uint32_t now = HAL_GetTick();
    if ((now - last_tx) >= 100) {
      last_tx = now;

      /* Formata 16 inteiros */
      int len = snprintf(txbuf, sizeof(txbuf),
                         "Spikes: %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu\r\n",
                         spikes[0],  spikes[1],  spikes[2],  spikes[3],
                         spikes[4],  spikes[5],  spikes[6],  spikes[7],
                         spikes[8],  spikes[9],  spikes[10], spikes[11],
                         spikes[12], spikes[13], spikes[14], spikes[15]);
      HAL_UART_Transmit(&huart3, (uint8_t*)txbuf, len, 10);
    }
  }
}

/* Callbacks -----------------------------------------------------------------*/

/* TIM6 update: troca a linha ativa logo após cada sequência ADC disparada.
   Observação: o TIM6 apenas gera o TRGO; a troca física de linha pode ser
   feita aqui (PeriodElapsed) para alinhar com novas leituras. */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
  if (htim->Instance == TIM6) {
    /* Seleciona nova linha */
    select_row(active_row);
    /* Pequeno settle (~5-10us) */
    for (volatile int i = 0; i < 800; i++) { __NOP(); }
    /* Próxima linha no próximo tick */
    active_row = (active_row + 1U) % ROWS;
  }
}

/* Fim da sequência (4 conversões) -> processa taxels da linha anterior */
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc) {
  if (hadc->Instance == ADC1) {
    uint8_t row_processed = (active_row + ROWS - 1U) % ROWS;

    for (int c = 0; c < COLS; c++) {
      int idx = row_processed * COLS + c;

      float I = Calibrate_Input(adc_buffer[c]);
      I_in[idx] = I;

      izhikevich_step(idx, I);

      if (v[idx] >= 30.0f) {
        v[idx] = c_rst;
        u[idx] += d_inc;
        spikes[idx]++;

        /* Pulso no PB8 */
        pulse_us_GPIOB8(12);
      }
    }
  }
}

