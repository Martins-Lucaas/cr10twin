#include "main.h"
#include <stdio.h>

#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS * COLS)

// Parâmetros do modelo Izhikevich
float a = 0.02f;
float b = 0.2f;
float c = -65.0f;
float d = 8.0f;

float v[NUM_SENSORS];
float u[NUM_SENSORS];
float I_in[NUM_SENSORS];
uint32_t spikes[NUM_SENSORS];

char msg[32];

// Mapeamento das linhas (GPIO saída)
GPIO_TypeDef* row_ports[ROWS] = {GPIOC, GPIOC, GPIOF, GPIOF};
uint16_t row_pins[ROWS]       = {GPIO_PIN_0, GPIO_PIN_3, GPIO_PIN_3, GPIO_PIN_5};

UART_HandleTypeDef huart3;

// Protótipos das funções de inicialização
void SystemClock_Config(void);
void MX_GPIO_Init(void);
void MX_USART3_UART_Init(void);
void Error_Handler(void);

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART3_UART_Init();

    // Inicializa variáveis do modelo
    for (int i = 0; i < NUM_SENSORS; i++) {
        v[i] = -65.0f;
        u[i] = b * v[i];
        spikes[i] = 0;
        I_in[i] = 3.0f;  // Corrente fixa alta para disparar spikes
    }

    // Teste: envia mensagem inicial só pra confirmar UART
    char init_msg[] = "Start spike test\n";
    HAL_UART_Transmit(&huart3, (uint8_t*)init_msg, sizeof(init_msg) - 1, HAL_MAX_DELAY);

    while (1) {
        // Ativa só a linha 0 (nível baixo), as outras em nível alto
        for (int rr = 0; rr < ROWS; rr++) {
            HAL_GPIO_WritePin(row_ports[rr], row_pins[rr], (rr == 0) ? GPIO_PIN_RESET : GPIO_PIN_SET);
        }

        for (int idx = 0; idx < COLS; idx++) {
            // Atualiza modelo Izhikevich (2 passos)
            for (int step = 0; step < 2; step++) {
                v[idx] += 0.5f * (0.04f * v[idx] * v[idx] + 5 * v[idx] + 140 - u[idx] + I_in[idx]);
                u[idx] += a * (b * v[idx] - u[idx]);
            }

            if (v[idx] >= 30.0f) {
                v[idx] = c;
                u[idx] += d;
                spikes[idx]++;

                // Envia spike via UART imediatamente
                int len = snprintf(msg, sizeof(msg), "Spike %d count %lu\n", idx, spikes[idx]);
                HAL_UART_Transmit(&huart3, (uint8_t*)msg, len, HAL_MAX_DELAY);
            }
        }

        HAL_Delay(10);
    }
}

// ------- CONFIGURAÇÕES DE HARDWARE -------

void SystemClock_Config(void) {
    RCC_OscInitTypeDef RCC_OscInitStruct = {0};
    RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

    __HAL_RCC_PWR_CLK_ENABLE();
    __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

    RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
    RCC_OscInitStruct.HSEState = RCC_HSE_ON;
    RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
    RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
    RCC_OscInitStruct.PLL.PLLM = 8;
    RCC_OscInitStruct.PLL.PLLN = 336;
    RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
    RCC_OscInitStruct.PLL.PLLQ = 7;
    if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) {
        Error_Handler();
    }

    RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK
                                  | RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
    RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
    RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
    RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;
    RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;

    if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_5) != HAL_OK) {
        Error_Handler();
    }
}

void MX_GPIO_Init(void) {
    GPIO_InitTypeDef GPIO_InitStruct = {0};

    __HAL_RCC_GPIOB_CLK_ENABLE();
    __HAL_RCC_GPIOC_CLK_ENABLE();
    __HAL_RCC_GPIOF_CLK_ENABLE();

    // Linhas da matriz (PC0, PC3, PF3, PF5)
    for (int i = 0; i < ROWS; i++) {
        GPIO_InitStruct.Pin = row_pins[i];
        GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
        GPIO_InitStruct.Pull = GPIO_NOPULL;
        GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
        HAL_GPIO_Init(row_ports[i], &GPIO_InitStruct);
    }

    // LED exemplo (opcional)
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_RESET);
    GPIO_InitStruct.Pin = GPIO_PIN_8;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOB, &GPIO_InitStruct);
}

void MX_USART3_UART_Init(void) {
    __HAL_RCC_USART3_CLK_ENABLE();

    huart3.Instance = USART3;
    huart3.Init.BaudRate = 115200;
    huart3.Init.WordLength = UART_WORDLENGTH_8B;
    huart3.Init.StopBits = UART_STOPBITS_1;
    huart3.Init.Parity = UART_PARITY_NONE;
    huart3.Init.Mode = UART_MODE_TX_RX;
    huart3.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    huart3.Init.OverSampling = UART_OVERSAMPLING_16;
    if (HAL_UART_Init(&huart3) != HAL_OK) {
        Error_Handler();
    }
}

void Error_Handler(void) {
    __disable_irq();
    while (1) {
    }
}
