#include "main.h"
#include <stdio.h>
#include <string.h>

/* ================== DEFINES E PARÂMETROS ================== */

#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS * COLS)

/* Modelo Izhikevich (RS padrão) */
static float a = 0.02f;
static float b = 0.2f;
static float c_rst = -65.0f;   // renomeado para evitar conflito com 'c' local
static float d_inc = 8.0f;

/* Buffers e estado do modelo */
static float v[NUM_SENSORS];
static float u[NUM_SENSORS];
static float I_in[NUM_SENSORS];
static uint32_t spikes[NUM_SENSORS];

/* UART (opcional) */
static char msg[64];

/* Mapeamento das linhas (GPIO saída) */
GPIO_TypeDef* row_ports[ROWS] = {GPIOC, GPIOC, GPIOF, GPIOF};
uint16_t      row_pins[ROWS]  = {GPIO_PIN_0, GPIO_PIN_3, GPIO_PIN_3, GPIO_PIN_5};
/*                      ^            ^             ^             ^
   PC0 (row 0)      PC3 (row 1)   PF3 (row 2)   PF5 (row 3)
   OBS: Você tinha dois "3" (PC3 e PF3), está correto nos arrays separados. */

/* Mapeamento das colunas (ADC entrada) */
static const uint32_t adc_channels[COLS] = {
    ADC_CHANNEL_9,   // PB1
    ADC_CHANNEL_12,  // PC2
    ADC_CHANNEL_5,   // PF4
    ADC_CHANNEL_0    // PA0
};

/* Calibração */
#define ADC_RESOLUTION      4095.0f
#define SENSOR_MAX_VOLTAGE  2.0f    // tensão máxima esperada do sensor
#define VREF                3.3f
#define I_MAX               5.0f    // corrente máxima para o modelo

/* ================== HANDLES ================== */

ADC_HandleTypeDef   hadc1;
DMA_HandleTypeDef   hdma_adc1;
UART_HandleTypeDef  huart3;
TIM_HandleTypeDef   htim6;

/* ================== ESTADO DE VARREDURA ================== */

static volatile uint8_t active_row = 0;     // linha ativa (0..3)
static volatile uint8_t adc_ready   = 0;    // sinaliza que o DMA terminou a conversão dessa linha
static uint32_t adc_buffer[COLS];           // resultados (4 colunas)

/* ================== PROTÓTIPOS ================== */

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_USART3_UART_Init(void);
static void MX_ADC1_Init(void);
static void MX_DMA_Init(void);
static void MX_TIM6_Init_4kHz(void);

static inline void select_row(uint8_t row);
static inline float Calibrate_Input(uint32_t adc_val);
static inline void izhikevich_step(int idx, float I);
static inline void pulse_us_GPIOB8(uint32_t us);

void Error_Handler(void);

/* ================== IMPLEMENTAÇÃO ================== */

static inline float Calibrate_Input(uint32_t adc_val) {
    float adc_max_expected = (SENSOR_MAX_VOLTAGE / VREF) * ADC_RESOLUTION;
    float normalized = ((float)adc_val) / adc_max_expected;
    if (normalized > 1.0f) normalized = 1.0f;
    if (normalized < 0.0f) normalized = 0.0f;
    return normalized * I_MAX;
}

static inline void select_row(uint8_t row) {
    /* Linha ativa em nível baixo, demais em alto */
    for (int r = 0; r < ROWS; r++) {
        HAL_GPIO_WritePin(row_ports[r], row_pins[r],
                          (r == row) ? GPIO_PIN_RESET : GPIO_PIN_SET);
    }
}

/* Passo do modelo (2 semi-passos de 0.5 ms cada para 1 ms total) */
static inline void izhikevich_step(int idx, float I) {
    for (int step = 0; step < 2; step++) {
        v[idx] += 0.5f * (0.04f * v[idx] * v[idx] + 5.0f * v[idx] + 140.0f - u[idx] + I);
        u[idx] += a * (b * v[idx] - u[idx]);
    }
}

/* Pulso curto ~10–15 us no PB8 (ajuste o laço conforme clock) */
static inline void pulse_us_GPIOB8(uint32_t us) {
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_SET);
    /* Busy-wait simples. Para ~216 MHz, ~8 NOP por ns… aqui só buscamos ordem de grandeza. */
    volatile uint32_t cycles = us * 80; // ajuste empírico se precisar
    while (cycles--) { __NOP(); }
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_8, GPIO_PIN_RESET);
}

/* ========== Callbacks de interrupção ========== */

/* TIM6: a 4 kHz — alterna a linha, dá um pequeno settle e dispare 1 sequência ADC (4 canais) */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim) {
    if (htim->Instance == TIM6) {
        /* Seleciona a nova linha ativa */
        select_row(active_row);

        /* Pequeno tempo de acomodação das linhas da matriz (alguns us) */
        for (volatile int i = 0; i < 800; i++) { __NOP(); } // ~5–10 us (ajuste conforme clock)

        /* Dispara uma sequência de conversões (4 canais) com DMA em modo NORMAL */
        adc_ready = 0;
        if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, COLS) != HAL_OK) {
            Error_Handler();
        }

        /* Próxima linha para o próximo tick */
        active_row = (active_row + 1) % ROWS;
    }
}

/* DMA completo: as 4 colunas foram lidas para a 'linha anterior' recém-selecionada */
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc) {
    if (hadc->Instance == ADC1) {
        adc_ready = 1;

        /* A linha processada é a que acabamos de selecionar no tick.
           Como já incrementamos active_row, a linha lida é (active_row + ROWS - 1) % ROWS. */
        uint8_t row_processed = (active_row + ROWS - 1) % ROWS;

        /* Atualiza modelo para os 4 taxels dessa linha (1 kHz por taxel) */
        for (int c_idx = 0; c_idx < COLS; c_idx++) {
            int idx = row_processed * COLS + c_idx;

            float I = Calibrate_Input(adc_buffer[c_idx]);
            I_in[idx] = I;

            izhikevich_step(idx, I);

            if (v[idx] >= 30.0f) {
                v[idx] = c_rst;
                u[idx] += d_inc;
                spikes[idx]++;

                /* Pulso curto (~10–15 us) em PB8 */
                pulse_us_GPIOB8(12);

                /* (Opcional) enviar via UART — cuidado: estamos em contexto de IRQ */
                // int len = snprintf(msg, sizeof(msg), "%d\n", idx);
                // HAL_UART_Transmit(&huart3, (uint8_t*)msg, len, 1);
            }
        }

        /* Em modo NORMAL o ADC já para ao concluir; nada a fazer aqui. */
    }
}

/* IRQHandlers “finos” */
void TIM6_DAC_IRQHandler(void) { HAL_TIM_IRQHandler(&htim6); }
void DMA2_Stream0_IRQHandler(void) { HAL_DMA_IRQHandler(&hdma_adc1); }

/* ================== MAIN ================== */

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_USART3_UART_Init();
    MX_TIM6_Init_4kHz();

    /* Inicializa modelo */
    for (int i = 0; i < NUM_SENSORS; i++) {
        v[i] = -65.0f;
        u[i] = b * v[i];
        spikes[i] = 0;
        I_in[i] = 0.0f;
    }

    /* Começa com a linha 0 ativa, mas o disparo de ADC é feito pelo TIM6 tick */
    active_row = 0;
    select_row(active_row);

    /* Inicia timer com interrupção */
    if (HAL_TIM_Base_Start_IT(&htim6) != HAL_OK) {
        Error_Handler();
    }

    while (1) {
