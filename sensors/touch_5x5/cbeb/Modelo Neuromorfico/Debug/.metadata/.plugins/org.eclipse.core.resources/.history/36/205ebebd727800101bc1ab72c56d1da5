/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_DMA_Init();
  MX_ADC1_Init();
  MX_USART3_UART_Init();
  MX_TIM6_Init();

  /* Inicia ADC em modo DMA */
  HAL_ADC_Start_DMA(&hadc1, adc_buffer, NUM_SENSORS);

  /* Inicia Timer se quiser usar interrupção periódica */
  HAL_TIM_Base_Start(&htim6);

  while (1)
  {
      // Aqui você pode processar adc_buffer e enviar spikes pela UART
      // Exemplo simples de envio:
      char msg[64];
      snprintf(msg, sizeof(msg), "ADC: %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu %lu\r\n",
          adc_buffer[0], adc_buffer[1], adc_buffer[2], adc_buffer[3],
          adc_buffer[4], adc_buffer[5], adc_buffer[6], adc_buffer[7],
          adc_buffer[8], adc_buffer[9], adc_buffer[10], adc_buffer[11],
          adc_buffer[12], adc_buffer[13], adc_buffer[14], adc_buffer[15]
      );
      HAL_UART_Transmit(&huart3, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
      HAL_Delay(100); // ajuste conforme a taxa de envio desejada
  }
}

