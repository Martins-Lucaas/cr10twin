/* Includes ------------------------------------------------------------------*/
#include "stm32f7xx_hal.h"
#include <stdio.h>
#include <string.h>

#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS*COLS)

/* Parâmetros do modelo Izhikevich */
float a = 0.02f;
float b = 0.2f;
float c = -65.0f;
float d = 8.0f;

/* Variáveis dos neurônios */
float v[NUM_SENSORS];
float u[NUM_SENSORS];

/* ADC DMA buffer */
uint16_t adc_buffer[NUM_SENSORS];

/* Handles HAL */
ADC_HandleTypeDef hadc1;
DMA_HandleTypeDef hdma_adc1;
UART_HandleTypeDef huart3;
TIM_HandleTypeDef htim6;

/* Protótipos */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_ADC1_Init(void);
static void MX_USART3_UART_Init(void);
static void MX_TIM6_Init(void);
void Error_Handler(void);
void process_neurons(void);

/* Mapear canais reais do ADC para cada sensor */
uint32_t adc_channels[NUM_SENSORS] = {
    ADC_CHANNEL_0, ADC_CHANNEL_1, ADC_CHANNEL_2, ADC_CHANNEL_3,
    ADC_CHANNEL_4, ADC_CHANNEL_5, ADC_CHANNEL_6, ADC_CHANNEL_7,
    ADC_CHANNEL_8, ADC_CHANNEL_9, ADC_CHANNEL_10, ADC_CHANNEL_11,
    ADC_CHANNEL_12, ADC_CHANNEL_13, ADC_CHANNEL_14, ADC_CHANNEL_15
};

/* Função principal */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_USART3_UART_Init();
    MX_TIM6_Init();

    /* Inicializa neurônios */
    for(int i=0;i<NUM_SENSORS;i++){
        v[i] = -65.0f;
        u[i] = b*v[i];
    }

    /* Inicia ADC com DMA circular */
    HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, NUM_SENSORS);

    /* Inicia Timer para 100 Hz */
    HAL_TIM_Base_Start_IT(&htim6);

    while(1)
    {
        /* loop vazio, processamento no timer */
    }
}

/* Processa neurônios via Izhikevich */
void process_neurons(void)
{
    int spike_flags[NUM_SENSORS] = {0};

    for(int i=0;i<NUM_SENSORS;i++)
    {
        float I = ((float)adc_buffer[i]/4095.0f)*10.0f;

        // Teste: força spike se ADC baixo
        if(I < 1.0f) I = 15.0f;

        v[i] += 0.5f*(0.04f*v[i]*v[i] + 5*v[i] + 140 - u[i] + I);
        v[i] += 0.5f*(0.04f*v[i]*v[i] + 5*v[i] + 140 - u[i] + I);
        u[i] += a*(b*v[i]-u[i]);

        if(v[i]>=30.0f)
        {
            spike_flags[i] = 1; // marca spike
            v[i] = c;
            u[i] += d;
        }
    }

    /* Envia spikes via UART */
    char msg[128];
    int len = snprintf(msg, sizeof(msg), "Spikes:");
    for(int i=0;i<NUM_SENSORS;i++){
        len += snprintf(msg+len, sizeof(msg)-len, " %d", spike_flags[i]);
    }
    len += snprintf(msg+len, sizeof(msg)-len, "\r\n");
    HAL_UART_Transmit(&huart3,(uint8_t*)msg,len,HAL_MAX_DELAY);
}

/* Callback do timer */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if(htim->Instance==TIM6)
    {
        process_neurons();
    }
}

/* Inicializações Cube HAL */
void SystemClock_Config(void){ /* Config padrão Cube */ }
static void MX_GPIO_Init(void){ /* GPIO linhas/colunas */ }

/* DMA circular para ADC */
static void MX_DMA_Init(void)
{
    __HAL_RCC_DMA2_CLK_ENABLE();

    hdma_adc1.Instance = DMA2_Stream0;
    hdma_adc1.Init.Channel = DMA_CHANNEL_0;
    hdma_adc1.Init.Direction = DMA_PERIPH_TO_MEMORY;
    hdma_adc1.Init.PeriphInc = DMA_PINC_DISABLE;
    hdma_adc1.Init.MemInc = DMA_MINC_ENABLE;
    hdma_adc1.Init.PeriphDataAlignment = DMA_PDATAALIGN_HALFWORD;
    hdma_adc1.Init.MemDataAlignment = DMA_MDATAALIGN_HALFWORD;
    hdma_adc1.Init.Mode = DMA_CIRCULAR;    // 🔹 modo circular
    hdma_adc1.Init.Priority = DMA_PRIORITY_HIGH;
    hdma_adc1.Init.FIFOMode = DMA_FIFOMODE_DISABLE;

    if(HAL_DMA_Init(&hdma_adc1) != HAL_OK) Error_Handler();

    __HAL_LINKDMA(&hadc1, DMA_Handle, hdma_adc1);
    HAL_NVIC_SetPriority(DMA2_Stream0_IRQn, 0, 0);
    HAL_NVIC_EnableIRQ(DMA2_Stream0_IRQn);
}

/* ADC1 configurado para multi-canal e trigger do TIM6 */
static void MX_ADC1_Init(void)
{
    ADC_ChannelConfTypeDef sConfig = {0};

    hadc1.Instance = ADC1;
    hadc1.Init.ClockPrescaler = ADC_CLOCK_SYNC_PCLK_DIV4;
    hadc1.Init.Resolution = ADC_RESOLUTION_12B;
    hadc1.Init.ScanConvMode = ENABLE;
    hadc1.Init.ContinuousConvMode = DISABLE;
    hadc1.Init.DiscontinuousConvMode = DISABLE;
    hadc1.Init.NbrOfDiscConversion = 0;
    hadc1.Init.ExternalTrigConvEdge = ADC_EXTERNALTRIGCONVEDGE_RISING;
    hadc1.Init.ExternalTrigConv = ADC_EXTERNALTRIG0_T6_TRGO;
    hadc1.Init.DataAlign = ADC_DATAALIGN_RIGHT;
    hadc1.Init.NbrOfConversion = NUM_SENSORS;
    hadc1.Init.DMAContinuousRequests = ENABLE;
    hadc1.Init.EOCSelection = ADC_EOC_SEQ_CONV;
    if(HAL_ADC_Init(&hadc1)!=HAL_OK) Error_Handler();

    /* Configura cada canal */
    for(int i=0;i<NUM_SENSORS;i++)
    {
        sConfig.Channel = adc_channels[i];
        sConfig.Rank = i+1;
        sConfig.SamplingTime = ADC_SAMPLETIME_3CYCLES;
        if(HAL_ADC_ConfigChannel(&hadc1,&sConfig)!=HAL_OK) Error_Handler();
    }
}

/* UART3 */
static void MX_USART3_UART_Init(void)
{
    huart3.Instance = USART3;
    huart3.Init.BaudRate = 115200;
    huart3.Init.WordLength = UART_WORDLENGTH_8B;
    huart3.Init.StopBits = UART_STOPBITS_1;
    huart3.Init.Parity = UART_PARITY_NONE;
    huart3.Init.Mode = UART_MODE_TX_RX;
    huart3.Init.HwFlowCtl = UART_HWCONTROL_NONE;
    huart3.Init.OverSampling = UART_OVERSAMPLING_16;
    if(HAL_UART_Init(&huart3)!=HAL_OK) Error_Handler();
}

/* TIM6 disparando a 100 Hz */
static void MX_TIM6_Init(void)
{
    TIM_MasterConfigTypeDef sMasterConfig = {0};

    htim6.Instance = TIM6;
    htim6.Init.Prescaler = 108-1;    // Ajuste: APB1 108 MHz / 108 = 1 MHz
    htim6.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim6.Init.Period = 10000-1;     // 1 MHz / 10000 = 100 Hz
    if(HAL_TIM_Base_Init(&htim6)!=HAL_OK) Error_Handler();

    sMasterConfig.MasterOutputTrigger = TIM_TRGO_UPDATE;
    sMasterConfig.MasterSlaveMode = TIM_MASTERSLAVEMODE_DISABLE;
    if(HAL_TIMEx_MasterConfigSynchronization(&htim6,&sMasterConfig)!=HAL_OK) Error_Handler();
}

void Error_Handler(void){ while(1) {} }



