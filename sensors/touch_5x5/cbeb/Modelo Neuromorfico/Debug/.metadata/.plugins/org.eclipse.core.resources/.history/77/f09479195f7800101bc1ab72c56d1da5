/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include <stdio.h>

/* Defines -------------------------------------------------------------------*/
#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS*COLS)

/* Private variables ---------------------------------------------------------*/
ADC_HandleTypeDef hadc1;
DMA_HandleTypeDef hdma_adc1;
TIM_HandleTypeDef htim6;
UART_HandleTypeDef huart3;

uint32_t adc_buffer[NUM_SENSORS];
float v[NUM_SENSORS];
float u[NUM_SENSORS];
float I[NUM_SENSORS];
uint8_t spike[NUM_SENSORS];

/* Function prototypes -------------------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_ADC1_Init(void);
static void MX_USART3_UART_Init(void);
static void MX_TIM6_Init(void);
void Error_Handler(void);

/* USER CODE BEGIN 0 ---------------------------------------------------------*/
void IzhikevichStep(uint8_t idx, float input)
{
    float dt = 0.01f;
    float a=0.02f, b=0.2f, c=-65.0f, d=8.0f;

    v[idx] += dt*(0.04f*v[idx]*v[idx] + 5*v[idx] + 140 - u[idx] + input);
    u[idx] += dt*a*(b*v[idx]-u[idx]);

    if(v[idx]>=30.0f)
    {
        v[idx] = c;
        u[idx] += d;
        spike[idx] = 1;
    }
    else
    {
        spike[idx] = 0;
    }
}

void SendSpikesUART()
{
    char msg[64];
    int len = snprintf(msg,sizeof(msg),"Spikes:");
    for(int i=0;i<NUM_SENSORS;i++)
        len += snprintf(msg+len,sizeof(msg)-len," %d",spike[i]);
    len += snprintf(msg+len,sizeof(msg)-len,"\r\n");
    HAL_UART_Transmit(&huart3,(uint8_t*)msg,len,10);
}

/* USER CODE END 0 -----------------------------------------------------------*/

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_USART3_UART_Init();
    MX_TIM6_Init();

    for(int i=0;i<NUM_SENSORS;i++){
        v[i] = -65.0f;
        u[i] = v[i]*0.2f;
    }

    if(HAL_ADC_Start_DMA(&hadc1, adc_buffer, NUM_SENSORS) != HAL_OK)
        Error_Handler();

    HAL_TIM_Base_Start_IT(&htim6);

    while (1)
    {
        // Processamento via TIM6
    }
}

/* Timer callback 10ms */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if(htim->Instance == TIM6)
    {
        float adc_mv;
        for(int i=0;i<NUM_SENSORS;i++)
        {
            adc_mv = 3.3f * ((float)adc_buffer[i]/4095.0f);
            I[i] = adc_mv;
            IzhikevichStep(i,I[i]);

            if(spike[i])
            {
                if(i<2)
                    HAL_GPIO_WritePin(GPIOF,(i==0?GPIO_PIN_3:GPIO_PIN_5),GPIO_PIN_SET);
                else
                    HAL_GPIO_WritePin(GPIOC,(i==2?GPIO_PIN_0:GPIO_PIN_3),GPIO_PIN_SET);
            }
            else
            {
                if(i<2)
                    HAL_GPIO_WritePin(GPIOF,(i==0?GPIO_PIN_3:GPIO_PIN_5),GPIO_PIN_RESET);
                else
                    HAL_GPIO_WritePin(GPIOC,(i==2?GPIO_PIN_0:GPIO_PIN_3),GPIO_PIN_RESET);
            }
        }
        SendSpikesUART();
    }
}

