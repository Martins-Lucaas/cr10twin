/* Izhikevich functions */
void izhikevich_init(void){
    for(int i=0; i<NUM_SENSORS; i++){
        v[i] = -65.0f;
        u[i] = b*v[i];
        I[i] = 0.0f;
    }
}

void izhikevich_update(float dt){
    for(int i=0; i<NUM_SENSORS; i++){
        if(v[i] >= 30.0f){
            v[i] = c;
            u[i] += d;
        }
        float dv = 0.04f*v[i]*v[i] + 5*v[i] + 140 - u[i] + I[i];
        float du = a*(b*v[i]-u[i]);
        v[i] += dv*dt;
        u[i] += du*dt;
    }
}

void read_adc_sensors(void){
    for(int i=0; i<NUM_SENSORS; i++){
        // Substitua abaixo pelo código de leitura real do ADC
        I[i] = 0.0f; // placeholder
    }
}

void send_spikes_uart(void){
    int len = 0;
    len += sprintf(uart_buf, "Spikes: ");
    for(int i=0; i<NUM_SENSORS; i++){
        if(v[i] >= 30.0f){
            len += sprintf(uart_buf+len, "1 ");
        } else {
            len += sprintf(uart_buf+len, "0 ");
        }
    }
    len += sprintf(uart_buf+len, "\r\n");
    HAL_UART_Transmit(&huart3, (uint8_t*)uart_buf, len, 10);
}

/* Main program -------------------------------------------------------------*/
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_USART3_UART_Init();
    MX_TIM6_Init();

    izhikevich_init();

    while(1)
    {
        read_adc_sensors();
        izhikevich_update(0.001f); // dt em segundos
        send_spikes_uart();
        HAL_Delay(10); // 100 Hz
    }
}

