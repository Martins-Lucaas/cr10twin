/* Private defines -----------------------------------------------------------*/
#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS*COLS)

/* Private variables ---------------------------------------------------------*/
ADC_HandleTypeDef hadc1;
DMA_HandleTypeDef hdma_adc1;
TIM_HandleTypeDef htim6;
UART_HandleTypeDef huart3;

/* Izhikevich model variables */
float a = 0.02f;
float b = 0.2f;
float c = -65.0f;
float d = 8.0f;

float v[NUM_SENSORS];
float u[NUM_SENSORS];
float I[NUM_SENSORS];

char uart_buf[128];

/* Function prototypes -------------------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
