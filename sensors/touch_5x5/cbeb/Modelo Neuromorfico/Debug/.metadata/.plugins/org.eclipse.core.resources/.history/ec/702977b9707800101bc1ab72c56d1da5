/* Private defines -----------------------------------------------------------*/
#define ROWS 4
#define COLS 4
#define NUM_SENSORS (ROWS * COLS)

/* Modelo Izhikevich */
float a = 0.02f;
float b = 0.2f;
float c = -65.0f;
float d = 8.0f;

float v[NUM_SENSORS];
float u[NUM_SENSORS];
float I[NUM_SENSORS];

uint16_t adc_buffer[NUM_SENSORS];
uint8_t spikes[NUM_SENSORS];

/* Handles gerados pelo Cube */
ADC_HandleTypeDef hadc1;
DMA_HandleTypeDef hdma_adc1;
UART_HandleTypeDef huart3;
TIM_HandleTypeDef htim6;

/* Prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_DMA_Init(void);
static void MX_ADC1_Init(void);
static void MX_USART3_UART_Init(void);
static void MX_TIM6_Init(void);

/* Função para enviar dados via UART */
void send_spikes(void)
{
    char msg[128];
    int len = sprintf(msg, "Spikes:");
    for (int i = 0; i < NUM_SENSORS; i++)
        len += sprintf(msg + len, " %d", spikes[i]);
    sprintf(msg + len, "\n");
    HAL_UART_Transmit(&huart3, (uint8_t *)msg, strlen(msg), HAL_MAX_DELAY);
}

/* Função de atualização do modelo Izhikevich */
void izhikevich_update(void)
{
    for (int i = 0; i < NUM_SENSORS; i++)
    {
        // Converte ADC para corrente normalizada (0–1)
        float adc_val = (float)adc_buffer[i] / 4095.0f;
        I[i] = adc_val * 20.0f; // Ajuste de ganho

        // Integração (passo duplo)
        v[i] += 0.5f * (0.04f * v[i] * v[i] + 5.0f * v[i] + 140.0f - u[i] + I[i]);
        v[i] += 0.5f * (0.04f * v[i] * v[i] + 5.0f * v[i] + 140.0f - u[i] + I[i]);
        u[i] += a * (b * v[i] - u[i]);

        if (v[i] >= 30.0f)
        {
            spikes[i] = 1;
            v[i] = c;
            u[i] += d;
        }
        else
        {
            spikes[i] = 0;
        }
    }
}

/* Callback do timer para processar leitura */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6)
    {
        izhikevich_update();
        send_spikes();
    }
}

/* Callback de ADC (DMA completo) */
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef *hadc)
{
    // Dados já estão em adc_buffer
}

/* Main ----------------------------------------------------------------------*/
int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_DMA_Init();
    MX_ADC1_Init();
    MX_USART3_UART_Init();
    MX_TIM6_Init();

    // Inicializa variáveis do modelo
    for (int i = 0; i < NUM_SENSORS; i++)
    {
        v[i] = -65.0f;
        u[i] = b * v[i];
    }

    // Inicia ADC + DMA
    HAL_ADC_Start_DMA(&hadc1, (uint32_t *)adc_buffer, NUM_SENSORS);

    // Inicia Timer
    HAL_TIM_Base_Start_IT(&htim6);

    while (1)
    {
        // MCU fica aqui em idle, processamento via callbacks
    }
}

